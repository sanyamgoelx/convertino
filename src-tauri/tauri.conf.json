{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Convertino",
  "version": "0.2.0-rc.2",
  "identifier": "com.crofty.convertino",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Convertino",
        "width": 600,
        "height": 520,
        "minWidth": 420,
        "minHeight": 360,
        "center": true,
        "visible": false
      },
      {
        "label": "wheel",
        "url": "wheel.html",
        "title": "Convertino wheel",
        "width": 420,
        "height": 490,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "shadow": false,
        "focus": true,
        "center": false
      },
      {
        "label": "hud",
        "url": "hud.html",
        "title": "Convertino progress",
        "width": 380,
        "height": 120,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "shadow": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob:; font-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "Crofty",
    "copyright": "Copyright (C) 2026 Crofty. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Convert any file from a radial wheel",
    "longDescription": "Hold Alt (Option on a Mac) and right-click any file in Explorer or Finder, pick a format on the wheel, and the converted file appears next to the original. A keyboard shortcut is optional. Runs offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "installer/dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 180
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "template": "installer/installer.nsi",
        "installerHooks": "installer/ui.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExQTZEQ0VGMjU4OTBGQzIKUldUQ0Q0a2w3OXltb1dDNFBlZWttV2ZQTTlqUGVWdk9ycU9oKyswREM5MUl1TzFPMVhteFhSZ1oK",
      "endpoints": [
        "https://github.com/sanyamgoelx/convertino/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
