<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime blocks Apple Events (asking Finder for its selection)
       unless this is set. Without it macOS never shows the "control Finder"
       prompt and Convertino never appears under Privacy > Automation. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
