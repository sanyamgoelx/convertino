      "label": "PDF",
      "color": "#C4262E",
      "extensions": [
        "pdf"
      ],
      "targets": [
        {
          "id": "pdf.jpg",
          "label": "JPG",
          "icon": "image",
          "ext": "jpg",
          "hint": "One image per page · 150 DPI"
        },
        {
          "id": "pdf.png",
          "label": "PNG",
          "icon": "image",
          "ext": "png",
          "hint": "Lossless image per page · 150 DPI"
        },
        {
          "id": "pdf.webp",
          "label": "WEBP",
          "icon": "image",
          "ext": "webp",
          "hint": "Smaller images, one per page"
        },
        {
          "id": "pdf.txt",
          "label": "TXT",
          "icon": "doc",
          "ext": "txt",
          "hint": "All text from every page"
        },
        {
          "id": "pdf.split",
          "label": "Split",
          "icon": "split",
          "action": true,
          "hint": "One PDF per page"
        },
        {
          "id": "pdf.compress",
          "label": "Compress",
          "icon": "compress",
          "action": true,
          "hint": "Pick a file size · pictures shrink first"
        },
        {
          "id": "pdf.edit",
          "label": "Edit",
          "icon": "edit",
          "action": true,
          "hint": "Rearrange, mark up, sign, straighten"
        },
        {
          "id": "pdf.merge",
          "label": "Merge",
          "icon": "merge",
          "action": true,
          "multi": true,
          "hint": "Combine the selected PDFs in name order"
